# ---------------------------------------------------------------------------
# Tool-agnostic settings.
#
# pnpm-specific settings (storeDir, approved build scripts) live in
# pnpm-workspace.yaml instead, so this file stays valid for npm and bun too.
# ---------------------------------------------------------------------------

# Reuse packages already present rather than checking the registry.
prefer-offline=true

# Never fail on a peer-dependency mismatch; some optional UI deps declare
# peers that are not actually required at runtime.
strict-peer-dependencies=false